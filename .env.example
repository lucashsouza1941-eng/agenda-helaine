# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Secreta: só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# Cloudflare Turnstile (anti-spam no /agendar). Opcional: sem as duas, o formulário funciona sem verificação.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua-site-key
# Secreta: só no servidor.
TURNSTILE_SECRET_KEY=sua-secret-key
